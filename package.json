{
  "name": "lapp-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "concurrently npm:watch:*",
    "install:all": "npm install && npm run install:frontend",
    "install:frontend": "cd frontend && npm install && cd ..",
    "watch:env": "node ./scripts/setup.env.js",
    "watch:frontend": "cd frontend && npm start",
    "watch:backend": "docker compose -f network/docker-compose.yml up",
    "start:backend:polar": "open -a Polar",
    "start:backend:compose": "docker compose -f network/docker-compose.yml up",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^7.5.0"
  }
}
