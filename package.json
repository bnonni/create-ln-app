{
  "name": "create-ln-app-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix packages/create-ln-app/template run install:all",
    "dev": "npm --prefix packages/create-ln-app/template run dev",
    "lint": "npm --prefix packages/create-ln-app/template run lint",
    "typecheck": "npm --prefix packages/create-ln-app/template run typecheck",
    "build": "npm --prefix packages/create-ln-app/template run build"
  }
}
