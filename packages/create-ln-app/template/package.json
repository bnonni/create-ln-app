{
  "name": "lapp-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install",
    "dev": "npm run network && concurrently -k -n server,frontend \"npm run server\" \"npm --prefix frontend run dev\"",
    "server": "node server/index.ts",
    "network": "npm run compose && docker compose -f network/docker-compose.yml up -d --wait && npm run bootstrap && npm run env",
    "down": "docker compose -f network/docker-compose.yml down",
    "compose": "node scripts/compose.ts",
    "reset": "node scripts/reset.ts",
    "doctor": "node scripts/doctor.ts",
    "bootstrap": "node scripts/bootstrap.ts",
    "env": "node scripts/env.ts",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "tsc -p tsconfig.json && npm --prefix frontend run typecheck",
    "test:integration": "node --test server/flow.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "undici": "^8.12.3"
  }
}
