# Written by `npm run env`. The next run replaces the LND_, CLN_, and BITCOIND_ values and keeps the other lines.
# The macaroon values are hex strings. The TLS cert paths are absolute paths on the host.
# The file has 3 LND_ lines for each LND node and 3 CLN_ lines for each CLN node in network/nodes.json.
# This example has the 3 default nodes. If bob is a CLN node, bob gets these lines:
# CLN_BOB_REST_URL=https://localhost:8082
# CLN_BOB_RUNE=<a rune with no restrictions, from lightning-cli showrunes>
# CLN_BOB_TLS_CERT_PATH=/path/to/your-app/network/data/bob/regtest/ca.pem
LND_ALICE_REST_URL=https://127.0.0.1:8081
LND_ALICE_MACAROON_HEX=<hex of network/data/alice/data/chain/bitcoin/regtest/admin.macaroon>
LND_ALICE_TLS_CERT_PATH=/path/to/your-app/network/data/alice/tls.cert
LND_BOB_REST_URL=https://127.0.0.1:8082
LND_BOB_MACAROON_HEX=<hex of network/data/bob/data/chain/bitcoin/regtest/admin.macaroon>
LND_BOB_TLS_CERT_PATH=/path/to/your-app/network/data/bob/tls.cert
LND_CAROL_REST_URL=https://127.0.0.1:8083
LND_CAROL_MACAROON_HEX=<hex of network/data/carol/data/chain/bitcoin/regtest/admin.macaroon>
LND_CAROL_TLS_CERT_PATH=/path/to/your-app/network/data/carol/tls.cert
BITCOIND_RPC_URL=http://127.0.0.1:18443
BITCOIND_RPC_USER=polaruser
BITCOIND_RPC_PASS=polarpass
