{
  "name": "lapp-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "config": {
    "port": 3000,
    "portEnv": "PORT",
    "appUrl": "http://localhost:3000"
  },
  "scripts": {
    "install:all": "npm install",
    "dev": "npm run network && npm run dev:app",
    "dev:app": "next dev",
    "start": "next start",
    "network": "npm run compose && docker compose -f network/docker-compose.yml up -d --wait --remove-orphans && npm run bootstrap && npm run env",
    "down": "docker compose -f network/docker-compose.yml down --remove-orphans",
    "compose": "node scripts/compose.ts",
    "reset": "node scripts/reset.ts",
    "doctor": "npm run compose && node scripts/doctor.ts",
    "bootstrap": "node scripts/bootstrap.ts",
    "env": "node scripts/env.ts",
    "build": "next build",
    "lint": "oxlint --max-warnings 0 src",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "node --test server/flow.test.ts"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
