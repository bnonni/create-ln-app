{
  "name": "create-ln-app",
  "version": "1.3.0",
  "description": "Make a Lightning app with a local regtest network: Bitcoin Core, 2 to 10 LND, Core Lightning, or Eclair nodes, an API server, and an example app.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnonni/create-ln-app.git",
    "directory": "packages/create-ln-app"
  },
  "bin": {
    "create-ln-app": "dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "!template/**/node_modules",
    "!template/.env",
    "!template/frontend/dist",
    "!template/network/data/*",
    "template/network/data/.gitkeep"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts",
    "js-template": "node scripts/js-template.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "ts-blank-space": "^0.9.0",
    "typescript": "^7.0.2"
  }
}
